          >
            <option value="all">{isAr ? 'جميع الخدمات / القطاعات' : 'All Ministries / Services'}</option>
            {services.map(s => (
              <option key={s.id} value={s.id}>
                {isAr ? (s.name_ar || s.name) : s.name}
